<?xml version="1.0" encoding="UTF-8"?>
<!-- The Windows installer (WiX v4: `wix build`, see docs/packaging.md).
     Variables: Version (major.minor.patch), ExePath, IcoPath, NoticesPath. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Tenon" Manufacturer="Tenon" Version="$(var.Version)"
           UpgradeCode="8f1f5c0e-6a52-4b8d-9d1c-2f4a7c3e9b61" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Tenon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IcoPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tenon" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Tenon" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppExeComponent">
        <File Id="AppExe" Source="$(var.ExePath)" KeyPath="yes" />
        <!-- .tnn files open with the program (the path arrives as its argument); their icon is
             the one embedded in app.exe, since a ProgId icon names a file, not an Icon. -->
        <ProgId Id="tenon.tnn" Description="Tenon model" Icon="AppExe" IconIndex="0">
          <Extension Id="tnn" ContentType="application/x-tenon">
            <Verb Id="open" Command="Open" TargetFile="AppExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Models saved before the project was renamed Tenon end in .skr and still open. -->
        <ProgId Id="tenon.skr" Description="Tenon model" Icon="AppExe" IconIndex="0">
          <Extension Id="skr" ContentType="application/x-tenon">
            <Verb Id="open" Command="Open" TargetFile="AppExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>
      <Component Id="NoticesComponent">
        <File Id="Notices" Source="$(var.NoticesPath)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="AppMenuFolder">
      <Component Id="StartMenuComponent">
        <Shortcut Id="StartMenuShortcut" Name="Tenon" Target="[INSTALLFOLDER]app.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\tenon" Name="installed" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Tenon" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
